# Copy to .env.prod and use:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger
POSTGRES_DB=messenger

# IMPORTANT: host must match the docker service name `postgres` for the server container.
DATABASE_URL=postgresql://messenger:messenger@postgres:5432/messenger?schema=public

JWT_SECRET=change_me_in_prod
CORS_ORIGIN=http://localhost:3000

# Closed alpha invite gate:
INVITE_REQUIRED=false

# Admin-only metrics endpoint:
ADMIN_USER_ID=

# This is baked into the Next.js build (client image build arg).
# For local docker compose, localhost works since your browser is on the host machine.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001

